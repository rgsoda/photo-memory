# Maintainer: Rafal Galczynski <rafalgalczynski@gmail.com>

# The tagged release, prebuilt. Installing this does not make you compile a
# webview binding; photomem-git is the one that tracks main.

pkgname=photomem-bin
_pkgname=photomem
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast visual note capture — hotkey, type, save, gone"
arch=('x86_64')
url="https://github.com/rgsoda/photo-memory"
license=('MIT')
# librsvg is not linked, it is dlopened: gdk-pixbuf loads it to draw SVG.
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'librsvg')
provides=("$_pkgname")
conflicts=("$_pkgname" "$_pkgname-git")
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
# Filled by `updpkgsums` once the release exists. The release workflow also
# publishes SHA256SUMS beside the tarball, which is the same number.
sha256sums=('SKIP')

package() {
    cd "$_pkgname-$pkgver-x86_64-linux"
    install -Dm755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 DESIGN.md "$pkgdir/usr/share/doc/$pkgname/DESIGN.md"
    install -Dm644 "$_pkgname.desktop" \
        "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 icons/32x32.png \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/$_pkgname.png"
    install -Dm644 icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_pkgname.png"
    install -Dm644 icons/icon.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_pkgname.png"
}
